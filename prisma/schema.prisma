// Meal Deal Hub Prisma database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Restaurant {
  id              Int      @id @default(autoincrement())
  restaurantId    String   @unique
  name            String
  active          Boolean  @default(true)
  acceptingOrders Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users          RestaurantUser[]
  orderDecisions OrderDecision[]
  payouts        RestaurantPayout[]
}

model RestaurantUser {
  id               Int       @id @default(autoincrement())
  restaurantId     Int
  email            String    @unique
  passwordHash     String
  firstName        String?
  lastName         String?
  active           Boolean   @default(true)
  activationToken  String?   @unique
  activationExpiry DateTime?
  activated        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model OrderDecision {
  id             Int      @id @default(autoincrement())
  shopifyOrderId String
  orderNumber    String
  restaurantId   Int
  status         String
  decidedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([shopifyOrderId, restaurantId])
  @@index([restaurantId])
  @@index([status])
}

model RestaurantPayout {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  weekStart    DateTime
  weekEnd      DateTime
  payoutDate   DateTime

  foodSales          Decimal @db.Decimal(10, 2)
  deliveryIncome     Decimal @db.Decimal(10, 2)
  commission         Decimal @db.Decimal(10, 2)
  serviceFees        Decimal @db.Decimal(10, 2)
  restaurantEarnings Decimal @db.Decimal(10, 2)

  acceptedOrderCount Int    @default(0)
  status             String @default("expected")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, weekStart])
  @@index([restaurantId])
  @@index([weekStart])
  @@index([payoutDate])
  @@index([status])
}
