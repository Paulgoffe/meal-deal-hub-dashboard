generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model OrderDecision {
  id             Int        @id @default(autoincrement())
  shopifyOrderId String
  orderNumber    String
  restaurantId   Int
  status         String

  decidedAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  foodSales      Decimal?   @db.Decimal(12, 2)
  deliveryIncome Decimal?   @db.Decimal(12, 2)
  serviceFee     Decimal?   @db.Decimal(12, 2)

  paymentCaptured Boolean   @default(false)
  capturedAt      DateTime?
  currencyCode    String?

  Restaurant Restaurant @relation(
    fields: [restaurantId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([shopifyOrderId, restaurantId])
  @@index([restaurantId])
  @@index([status])
}

model Restaurant {
  id               Int                @id @default(autoincrement())
  restaurantId     String             @unique
  name             String
  active           Boolean            @default(true)
  acceptingOrders  Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  OrderDecision    OrderDecision[]
  RestaurantPayout RestaurantPayout[]
  RestaurantUser   RestaurantUser[]
}

model RestaurantPayout {
  id                 Int        @id @default(autoincrement())
  restaurantId       Int
  weekStart          DateTime
  weekEnd            DateTime
  payoutDate         DateTime
  foodSales          Decimal    @db.Decimal(10, 2)
  deliveryIncome     Decimal    @db.Decimal(10, 2)
  commission         Decimal    @db.Decimal(10, 2)
  serviceFees        Decimal    @db.Decimal(10, 2)
  restaurantEarnings Decimal    @db.Decimal(10, 2)
  acceptedOrderCount Int        @default(0)
  status             String     @default("expected")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime
  Restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, weekStart])
  @@index([payoutDate])
  @@index([restaurantId])
  @@index([status])
  @@index([weekStart])
}

model RestaurantUser {
  id               Int        @id @default(autoincrement())
  restaurantId     Int
  email            String     @unique
  passwordHash     String
  firstName        String?
  lastName         String?
  active           Boolean    @default(true)
  activationToken  String?    @unique
  activationExpiry DateTime?
  activated        Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime
  Restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}
